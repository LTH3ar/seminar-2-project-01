# --------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --------------------------------------------------------------------------
# Data
#
# The competition CSVs are downloaded on demand by ai4se.loader, and the
# processed files are regenerated by the Track A notebook, so neither belongs
# in the repository. The directories themselves are kept via .gitkeep.
# --------------------------------------------------------------------------
data/raw/*
data/processed/*

# --------------------------------------------------------------------------
# Results
#
# Figures and tables ARE committed once generated: the LaTeX report references
# them, and the lecturer should be able to see them without re-running anything.
# Model checkpoints and raw prediction dumps are not -- they are large and fully
# reproducible.
# --------------------------------------------------------------------------
results/models/*
results/predictions/*
*.pt
*.pth
*.ckpt
*.safetensors
*.joblib
*.pkl

# --------------------------------------------------------------------------
# LaTeX build products
# --------------------------------------------------------------------------
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.lof
report/*.log
report/*.lot
report/*.out
report/*.run.xml
report/*.synctex.gz
report/*.toc

# --------------------------------------------------------------------------
# Training artefacts
#
# SetFit's Trainer writes checkpoints into the working directory by default,
# which is hundreds of megabytes per run. They are reproducible from
# scripts/run_experiments.py and must never reach the repository.
# --------------------------------------------------------------------------
checkpoints/
runs/
outputs/
wandb/
*.safetensors

# --------------------------------------------------------------------------
# Editor and OS noise
# --------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp

# --------------------------------------------------------------------------
# Directory placeholders are never ignored.
#
# This negation must come last: it re-includes .gitkeep even inside the
# directories excluded above, so the project structure survives a fresh clone
# even when every directory is empty.
# --------------------------------------------------------------------------
!.gitkeep
!**/.gitkeep
