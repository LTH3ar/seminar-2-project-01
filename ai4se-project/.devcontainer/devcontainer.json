{
  "name": "AI4SE Project 1 - Issue Report Classification",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "PYTHON_VERSION": "3.11",
      // Set to "false" to skip the ~1 GB LaTeX toolchain. Only the member
      // who compiles the report actually needs it.
      "INSTALL_LATEX": "true"
    }
  },
  // Created in the Dockerfile at UID/GID 1000; the official Python image
  // ships no non-root user.
  "remoteUser": "vscode",
  "containerUser": "vscode",
  // "features": {
  //   "ghcr.io/devcontainers/features/common-utils": {
  //     "configureZshAsDefaultShell": true
  //   }
  // },
  // No "features" block: git, sudo and the VS Code server prerequisites are
  // installed explicitly in the Dockerfile, so the image depends on nothing
  // beyond the official Python base.
  // Runs on the HOST before the container starts. Copies ~/.zsh_history and
  // ~/.ssh into ~/.cache/ai4se-devcontainer/host-seed; the originals are only
  // read, never mounted and never written. Linux, macOS and WSL hosts.
  "initializeCommand": "bash .devcontainer/stage-host-files.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Installs the staged copies into ~/.ssh (every start) and seeds the zsh
  // history volume (first start only).
  "postStartCommand": "bash .devcontainer/sync-host-files.sh",
  "forwardPorts": [
    8888
  ],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter Lab",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "charliermarsh.ruff",
        "njpwerner.autodocstring",
        "James-Yu.latex-workshop",
        "eamodio.gitlens",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "python.testing.unittestEnabled": false,
        "editor.formatOnSave": true,
        "editor.rulers": [
          88
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "notebook.output.textLineLimit": 60,
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.defaultProfile.osx": "zsh",
        "terminal.integrated.defaultProfile.windows": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": [
              "-l"
            ]
          },
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        },
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true,
          "**/.ipynb_checkpoints": true
        }
      }
    }
  },
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "NLTK_DATA": "/home/vscode/nltk_data",
    "HF_HOME": "/home/vscode/.cache/huggingface",
    "TOKENIZERS_PARALLELISM": "false"
  },
  // Named volumes keep pip wheels, the HuggingFace model cache and the VS Code
  // server across rebuilds. The target directories are created and chowned to
  // vscode in the Dockerfile so the volumes inherit the right ownership.
  "mounts": [
    "source=ai4se-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=ai4se-hf-cache,target=/home/vscode/.cache/huggingface,type=volume",
    "source=ai4se-vscode-server,target=/home/vscode/.vscode-server,type=volume",
    // Shell history, completion cache. Survives rebuilds.
    "source=ai4se-zsh-state,target=/home/vscode/.zsh_state,type=volume",
    // The host-side COPIES made by stage-host-files.sh, read-only. The
    // container cannot write here, and never sees the host's ~/.ssh itself.
    "source=${localEnv:HOME}/.cache/ai4se-devcontainer/host-seed,target=/home/vscode/.host-seed,type=bind,readonly"
  ],
  // Uncomment to expose an NVIDIA GPU to the container for track C.
  // Requires the NVIDIA Container Toolkit on the host.
  // "hostRequirements": { "gpu": "optional" },
  // "runArgs": ["--gpus", "all", "--shm-size=2g"],
  "waitFor": "postCreateCommand"
}